# Copy to backend/.env and edit. NEVER commit .env
# Replace YOUR_DB_PASSWORD with your local PostgreSQL password.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/brightloop
TEST_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@localhost:5432/brightloop_test

# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FRONTEND_ORIGIN=http://localhost:5173

# Seeded admin (python -m app.seed)
ADMIN_EMAIL=admin@brightloop.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Brightloop Admin

# development | production (forgot-password returns the token only in development)
APP_ENV=development
